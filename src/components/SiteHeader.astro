---
import { site, nav } from '../data/site';

const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/' || pathname === '';
  if (href === '/projects/') return pathname === '/projects/' || pathname === '/projects';
  return pathname.startsWith(href);
}
---

<header class="site-header">
  <a class="site-mark" href="/" aria-label={site.name}>
    <span class="site-mark-text">{site.name}</span>
  </a>
  <p class="site-stamp" id="site-stamp" aria-live="polite">
    <span class="site-stamp-fallback">--/--/---- --:--am {site.location}</span>
  </p>
  <nav class="site-nav" aria-label="Primary">
    {
      nav.map(({ label, href }) => (
        <a href={href} class:list={[{ active: isActive(href) }]} aria-current={isActive(href) ? 'page' : undefined}>
          {label}
        </a>
      ))
    }
  </nav>
</header>

<script is:inline define:vars={{ location: site.location, timeZone: site.timeZone }}>
  (function () {
    var el = document.getElementById('site-stamp');
    if (!el) return;

    function pad(n) {
      return n < 10 ? '0' + n : String(n);
    }

    function part(parts, type) {
      var p = parts.find(function (x) {
        return x.type === type;
      });
      return p ? p.value : '';
    }

    function render() {
      var parts = new Intl.DateTimeFormat('en-US', {
        timeZone: timeZone,
        month: 'numeric',
        day: 'numeric',
        year: 'numeric',
        hour: 'numeric',
        minute: '2-digit',
        hour12: true,
      }).formatToParts(new Date());

      var month = pad(Number(part(parts, 'month')));
      var day = pad(Number(part(parts, 'day')));
      var h = part(parts, 'hour');
      var m = part(parts, 'minute');
      var ampm = part(parts, 'dayPeriod').toLowerCase();

      el.textContent = month + '/' + day + '/' + part(parts, 'year') + ' ' + h + ':' + m + ampm + ' ' + location;
    }

    render();
    setInterval(render, 30000);
  })();
</script>

<style>
  .site-header {
    text-align: center;
    padding: var(--pad-top) 0 2.5rem;
  }

  .site-mark {
    display: inline-block;
    background: var(--mark);
    color: var(--bg);
    padding: 0.35rem 0.65rem;
    text-decoration: none;
    line-height: 1;
  }

  .site-mark:hover,
  .site-mark:focus-visible {
    text-decoration: none;
    background: #bf4000;
  }

  .site-mark-text {
    font-size: 12px;
    letter-spacing: 0.02em;
  }

  .site-stamp {
    margin: 0.85rem 0 0;
    font-size: 12px;
    line-height: 1;
  }

  .site-stamp-fallback {
    visibility: hidden;
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .site-nav {
    margin-top: 1.75rem;
    font-size: 12px;
    line-height: 1;
    display: flex;
    justify-content: center;
    gap: 1.5rem;
  }

  .site-nav a {
    text-decoration: none;
    text-transform: lowercase;
  }

  .site-nav a:hover,
  .site-nav a:focus-visible,
  .site-nav a.active {
    text-decoration: underline;
  }
</style>
